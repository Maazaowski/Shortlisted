# Copy to .env at the repo root. Every app and package reads this one file,
# and docker-compose.yml interpolates the values it needs from it.

# Postgres, as published by docker-compose.yml. Inside the containers the
# compose file overrides this with the db service's address.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/shortlisted

# Who runs the model calls. Leave unset and it picks itself: anthropic when a
# key is present, manual otherwise. Manual means the app builds a prompt, you
# paste it into Claude, and paste the JSON reply back. Free, one round trip
# per capture.
SHORTLISTED_PROVIDER=

# Anthropic API key, only for the anthropic provider. Billed per token.
ANTHROPIC_API_KEY=

# Model override. Leave blank for the default (claude-opus-5).
SHORTLISTED_MODEL=

# Port the web app is published on. The extension's API base must match.
WEB_PORT=3000

# Where generated PDFs are written when running on the host. The containers use /data/files,
# bind-mounted to ./data/files, so both paths point at the same directory.
STORAGE_DIR=./data/files

# Typst binary when running the worker on the host. Leave unset if `typst` is on PATH.
# Install: winget install Typst.Typst
TYPST_BIN=
