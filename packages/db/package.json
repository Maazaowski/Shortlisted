{
  "name": "@shortlisted/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate",
    "migrate": "tsx scripts/prisma.ts migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "tsx scripts/prisma.ts studio",
    "seed": "tsx scripts/seed-dev.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
