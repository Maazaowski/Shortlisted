{
  "name": "shortlisted",
  "version": "0.0.0",
  "private": true,
  "description": "One-click tailored resumes from any job page, plus a pipeline tracker from Saved to Offer.",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter @shortlisted/db migrate",
    "db:generate": "pnpm --filter @shortlisted/db generate",
    "db:studio": "pnpm --filter @shortlisted/db studio",
    "worker": "pnpm --filter @shortlisted/worker dev",
    "web": "pnpm --filter @shortlisted/web dev",
    "ext:build": "pnpm --filter @shortlisted/extension build",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  }
}
